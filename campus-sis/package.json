{
  "name": "atlas",
  "version": "0.0.0",
  "private": true,
  "description": "ATLAS — multi-tenant Student Information System for African higher education. Monorepo root.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "api": "pnpm --filter @atlas/api",
    "dev": "pnpm --filter @atlas/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @atlas/api db:migrate",
    "db:seed": "pnpm --filter @atlas/api db:seed"
  }
}
