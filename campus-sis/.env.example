# ─────────────────────────────────────────────────────────────────────────────
# ATLAS — environment template. Copy to `.env` for local dev (never commit .env).
# In Render/Railway these are set as service env vars / secrets, not from a file.
# ─────────────────────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Postgres. Local default matches docker-compose.yml.
# The app connects as a NON-superuser so Row-Level Security is actually enforced.
DATABASE_URL=postgres://atlas_app:atlas_app@localhost:5432/atlas

# Auth / crypto (Phase 0 placeholders — real values land with the auth module)
# Generate: `openssl rand -base64 48`
JWT_SECRET=change-me-dev-only
OTP_TTL_SECONDS=300

# Object storage (S3-compatible). Render Disks / Cloudflare R2 / Backblaze B2.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=atlas-documents
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Payments — Flutterwave (reference adapter; TEST keys for dev)
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
FLW_WEBHOOK_SECRET_HASH=

# Notifications
SMS_PROVIDER=
SMS_API_KEY=
EMAIL_FROM=no-reply@atlas.africa
EMAIL_API_KEY=

# Observability
SENTRY_DSN=
